{
    "name": "jeremy379/laravel-storage-cli",
    "description": "Read-only Artisan commands to explore Laravel filesystem disks, inspect files, generate URLs, and download files.",
    "type": "library",
    "keywords": [
        "laravel",
        "artisan",
        "filesystem",
        "storage",
        "cli",
        "s3"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "league/flysystem": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Jeremy379\\LaravelStorageCli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jeremy379\\LaravelStorageCli\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jeremy379\\LaravelStorageCli\\StorageCliServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
